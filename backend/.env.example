# Database (Use MongoDB Atlas for production)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/excelAnalytics

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_here_make_it_very_long_and_complex
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_make_it_different_and_complex

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Configuration (Update with your deployed frontend URL)
FRONTEND_URL=https://your-app-name.vercel.app

# Server Configuration
PORT=3001

# Security
NODE_ENV=production
